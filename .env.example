# FineVision local demo environment.
# Copy to .env for local secrets or provider-specific overrides. Do not commit .env.

# PostgreSQL URL for host-run commands such as `uv run alembic upgrade head`.
# Docker Compose services use the same credentials inside the compose network.
DATABASE_URL=postgresql+psycopg://finevision:finevision@localhost:5432/finevision
FINEVISION_TEST_DATABASE_URL=postgresql+psycopg://finevision:finevision@localhost:5432/finevision_test
FINEVISION_DATABASE_URL=postgres://finevision:finevision@localhost:5432/finevision

# Runtime directories for host-run API/worker processes.
FINEVISION_METADATA_DIR=.finevision-api/metadata
FINEVISION_ARTIFACT_DIR=.finevision-api/artifacts
FINEVISION_UPLOAD_DIR=.finevision-api/uploads
FINEVISION_IMPORTED_DATASET_DIR=.finevision-api/imported-datasets
FINEVISION_SAMPLE_ASSET_DIR=data/test/cifar10-mini-imagefolder

# Frontend API base URL when running Vite outside Docker Compose.
VITE_API_BASE_URL=http://localhost:8001

# Control Plane, RabbitMQ and private service-to-service authentication.
FINEVISION_HTTP_ADDRESS=:8000
FINEVISION_GRPC_ADDRESS=:9000
FINEVISION_LEASE_TTL=150s
FINEVISION_RABBITMQ_URL=amqp://finevision:finevision@localhost:5672/
FINEVISION_LLM_GATEWAY_URL=http://localhost:8080
# Replace this value outside the isolated local Compose network.
FINEVISION_LLM_INTERNAL_TOKEN=finevision-dev-internal-only

# S3-compatible ArtifactStore (the Compose profile uses a pinned MinIO development image).
FINEVISION_S3_ENDPOINT=http://localhost:9000
FINEVISION_S3_REGION=us-east-1
FINEVISION_S3_ACCESS_KEY=finevision
FINEVISION_S3_SECRET_KEY=finevision-dev-object-secret
FINEVISION_ARTIFACT_BUCKET=finevision-artifacts

# Optional ML compute settings. Leave unset for CPU-safe smoke/demo.
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=
# FINEVISION_COMPUTE_DEVICE=cpu
# FINEVISION_LINEAR_HEAD_DEVICE=cpu
# FINEVISION_FEATURE_BATCH_SIZE=8

# Optional advisory LLM settings. Only the Go LLM Gateway receives these values.
# FINEVISION_LLM_API_KEY=
FINEVISION_LLM_PROVIDER=OpenAI-compatible
FINEVISION_LLM_BASE_URL=https://api.openai.com/v1
FINEVISION_LLM_MODEL=gpt-5.5
# DeepSeek vision alternative (credentials stay in ignored .env, gateway only):
# FINEVISION_LLM_PROVIDER=DeepSeek
# FINEVISION_LLM_BASE_URL=https://api.deepseek.com
# FINEVISION_LLM_MODEL=deepseek-v4-flash-vision-exp

# Optional legacy review image access for the Go control plane. Mount this exact
# upload directory read-only when reviewed images are not registered artifacts.
# Reviewed object-store images are resolved by their verified artifacts.uri.
# FINEVISION_UPLOAD_DIR=/absolute/path/to/.finevision-api/uploads
