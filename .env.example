# FineVision local demo environment.
# Copy to .env for local secrets or provider-specific overrides. Do not commit .env.

# PostgreSQL URL for host-run commands such as `uv run alembic upgrade head`.
# Docker Compose services use the same credentials inside the compose network.
DATABASE_URL=postgresql+psycopg://finevision:finevision@localhost:5432/finevision
FINEVISION_TEST_DATABASE_URL=postgresql+psycopg://finevision:finevision@localhost:5432/finevision_test

# Runtime directories for host-run API/worker processes.
FINEVISION_METADATA_DIR=.finevision-api/metadata
FINEVISION_ARTIFACT_DIR=.finevision-api/artifacts
FINEVISION_UPLOAD_DIR=.finevision-api/uploads
FINEVISION_IMPORTED_DATASET_DIR=.finevision-api/imported-datasets
FINEVISION_SAMPLE_ASSET_DIR=data/test/cifar10-mini-imagefolder

# Frontend API base URL when running Vite outside Docker Compose.
VITE_API_BASE_URL=http://localhost:8001

# Optional DINOv3/Hugging Face settings. Leave unset for CPU-safe smoke/demo.
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=
# FINEVISION_DINOV3_DEVICE=cpu
# FINEVISION_LINEAR_HEAD_DEVICE=cpu
# FINEVISION_DINOV3_BATCH_SIZE=8

# Optional advisory LLM settings. These are not required for the default demo smoke.
# OPENAI_API_KEY=
# FINEVISION_LLM_API_KEY=
FINEVISION_LLM_PROVIDER=OpenAI
FINEVISION_LLM_BASE_URL=https://api.openai.com/v1
FINEVISION_LLM_MODEL=gpt-5.5
FINEVISION_LLM_REVIEW_MODEL=gpt-5.5
FINEVISION_LLM_FALLBACK_MODELS=
FINEVISION_LLM_REASONING_EFFORT=high
FINEVISION_LLM_DISABLE_RESPONSE_STORAGE=true
FINEVISION_LLM_WIRE_API=responses
# Use auto to try Responses first, then Chat Completions for OpenAI-compatible gateways.
# FINEVISION_LLM_WIRE_API=auto
FINEVISION_LLM_REQUIRES_OPENAI_AUTH=true
FINEVISION_LLM_STRUCTURED_OUTPUTS=true
FINEVISION_LLM_TIMEOUT_SECONDS=60

# Fine-R1 candidate-reranking service. Run a remote service or enable the
# vlm-local Docker Compose profile on a machine with a 24 GB GPU.
FINEVISION_FINER1_SERVICE_URL=http://fine-r1-service:8010
FINEVISION_FINER1_MODEL_ID=Fine-R1-3B
FINEVISION_FINER1_MODEL_PATH=StevenHH2000/Fine-R1-3B
FINEVISION_FINER1_MODEL_REVISION=6da43fdd30df0101bbb81f4ae5ad9e6117bf3619
FINEVISION_FINER1_PROMPT_VERSION=finevision-finer1-v1.1
FINEVISION_FINER1_MAX_NEW_TOKENS=1024
FINEVISION_FINER1_TIMEOUT_SECONDS=180
FINEVISION_FINER1_LEASE_SECONDS=900
FINEVISION_FINER1_MAX_ATTEMPTS=3
FINEVISION_FINER1_AUTO_ENABLED=false
