FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/backend/src
WORKDIR /app
RUN pip install --no-cache-dir \
    prometheus-client==0.26.0 \
    opentelemetry-api==1.44.0 \
    opentelemetry-sdk==1.44.0 \
    opentelemetry-exporter-otlp-proto-grpc==1.44.0 \
    opentelemetry-instrumentation-grpc==0.65b0
COPY backend/src/finevision/observability /app/backend/src/finevision/observability
COPY backend/src/finevision/compute/hardware_collector.py /app/backend/src/finevision/compute/hardware_collector.py
USER 65534:65534
CMD ["python", "-m", "finevision.compute.hardware_collector"]
